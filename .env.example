APP_NAME=Fiberloop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fiberloop
DB_USERNAME=fiberloop
DB_PASSWORD=fiberloop_secret

# Session - Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache - Redis
CACHE_STORE=redis

# Queue - Redis
QUEUE_CONNECTION=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Multi-tenancy (stancl/tenancy)
TENANCY_CENTRAL_CONNECTION=pgsql

# FreeRADIUS (Phase 7)
RADIUS_HOST=127.0.0.1
RADIUS_PORT=1812
RADIUS_SECRET=testing123
RADIUS_DB_CONNECTION=radius
RADIUS_DB_HOST=postgres
RADIUS_DB_PORT=5432
RADIUS_DB_DATABASE=fiberloop
RADIUS_DB_USERNAME=fiberloop
RADIUS_DB_PASSWORD=fiberloop_secret
RADIUS_DB_SCHEMA=public

# Payment Gateways (Phase 6)
STRIPE_KEY=
STRIPE_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# MikroTik API (Phase 8)
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASSWORD=

# Reverb (Realtime)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost

# Vite
VITE_APP_NAME="${APP_NAME}"
